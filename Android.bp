soong_namespace {
}

cc_binary {
	name: "android.hardware.thermal-service.qti",
	relative_install_path: "hw",
	init_rc: ["android.hardware.thermal-service.qti.rc"],
	vintf_fragments: ["android.hardware.thermal-service.qti.xml"],
	vendor: true,
	shared_libs: [
	"libbase",
	"libbinder_ndk",
	"android.hardware.thermal-V2-ndk",
	"libcutils",
	"libutils",
	"liblog",
	"libnl",
	],
	srcs: [
		"service.cpp",
		"thermal.cpp",
		"thermalConfig.cpp",
		"thermalCommon.cpp",
		"thermalUtilsNetlink.cpp",
		"thermalMonitorNetlink.cpp",
	],
	header_libs: ["liblog_headers", "libcutils_headers"],
	cflags: [
		"-Wno-unused-parameter",
		"-Wno-unused-variable",
		"-DENABLE_THERMAL_NETLINK",
		"-fexceptions",
	],
}

vintf_fragment {
	name: "thermal-qti-system-vintf",
	src: "android.hardware.thermal-service.qti.system.xml",
}

cc_binary {
	name: "android.hardware.thermal-service.qti.system",
	relative_install_path: "hw",
	init_rc: ["android.hardware.thermal-service.qti.system.rc"],
	// Declares IThermal/default, which the framework binds in preference to the
	// stock HIDL provider. Proven first under a non-default instance.
	vintf_fragment_modules: ["thermal-qti-system-vintf"],
	shared_libs: [
		"libbase",
		"libbinder_ndk",
		"libcutils",
		"libutils",
		"liblog",
		"libnl",
	],
	static_libs: ["android.hardware.thermal-V2-ndk"],
	srcs: [
		"service.cpp",
		"thermal.cpp",
		"thermalConfig.cpp",
		"thermalCommon.cpp",
		"thermalUtilsNetlink.cpp",
		"thermalMonitorNetlink.cpp",
	],
	header_libs: ["liblog_headers", "libcutils_headers"],
	cflags: [
		"-Wno-unused-parameter",
		"-Wno-unused-variable",
		"-DENABLE_THERMAL_NETLINK",
		"-fexceptions",
	],
}

cc_binary {
	name: "android.hardware.thermal-service.qti.odm",
	stem: "android.hardware.thermal-service.qti",
	relative_install_path: "hw",
	init_rc: ["android.hardware.thermal-service.qti.odm.rc"],
	vintf_fragments: ["android.hardware.thermal-service.qti.odm.xml"],
	device_specific: true,
	stl: "libc++_static",
	shared_libs: [
		"libbase",
		"libbinder_ndk",
		"libcutils",
		"libutils",
		"liblog",
		"libnl",
	],
	static_libs: ["android.hardware.thermal-V2-ndk"],
	srcs: [
		"service.cpp",
		"thermal.cpp",
		"thermalConfig.cpp",
		"thermalCommon.cpp",
		"thermalUtilsNetlink.cpp",
		"thermalMonitorNetlink.cpp",
	],
	header_libs: ["liblog_headers", "libcutils_headers"],
	cflags: [
		"-Wno-unused-parameter",
		"-Wno-unused-variable",
		"-DENABLE_THERMAL_NETLINK",
		"-fexceptions",
	],
}

cc_fuzz {
    name: "aidl_fuzzer_thermal",
    vendor: true,

    shared_libs: [
        "liblog",
        "libbase",
        "libutils",
        "libcutils",
        "libbinder",
        "libbinder_ndk",
        "android.hardware.thermal-V2-ndk",
        "libnl",
    ],

    srcs: [
        "fuzzer.cpp",
        "thermal.cpp",
        "thermalConfig.cpp",
        "thermalCommon.cpp",
        "thermalUtilsNetlink.cpp",
        "thermalMonitorNetlink.cpp",
    ],
    header_libs: ["liblog_headers", "libcutils_headers"],

    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-DENABLE_THERMAL_NETLINK",
        "-fexceptions",
    ],

    static_libs: [
        "libbinder_random_parcel",
    ],

}

cc_binary {
    name: "thermal_selftest",
    system_ext_specific: true,
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libutils",
        "liblog",
        "libnl",
    ],
    static_libs: ["android.hardware.thermal-V2-ndk"],
    srcs: [
        "thermal_selftest.cpp",
        "thermal.cpp",
        "thermalConfig.cpp",
        "thermalCommon.cpp",
        "thermalUtilsNetlink.cpp",
        "thermalMonitorNetlink.cpp",
    ],
    header_libs: ["liblog_headers", "libcutils_headers"],
    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-DENABLE_THERMAL_NETLINK",
        "-fexceptions",
    ],
}

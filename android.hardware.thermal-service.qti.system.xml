<!--
Declares the default instance, so ThermalManagerService binds this provider in
preference to the stock HIDL one.

This is only safe because the provider was first proven under a non-default
instance on the same device: it started, registered, and answered with 24
temperatures and 14 cooling devices. The framework binds through
waitForDeclaredService, which blocks, so a declaration is a commitment that the
service will arrive.
-->
<manifest version="2.0" type="framework">
    <hal format="aidl">
        <name>android.hardware.thermal</name>
        <version>2</version>
        <fqname>IThermal/default</fqname>
    </hal>
</manifest>

# SPDX-License-Identifier: BSD-3-Clause-Clear

# class hal, not late_start. ThermalManagerService binds the AIDL HAL from
# onActivityManagerReady during system server startup, which runs before
# late_start, and it binds with waitForDeclaredService, which blocks. A
# declared instance that starts late would therefore leave the system server
# waiting between the boot trigger and boot-completed, which is how the earlier
# ODM attempt failed.
service thermal-hal-system /system/bin/hw/android.hardware.thermal-service.qti.system
    class hal
    user system
    group system

# SPDX-License-Identifier: BSD-3-Clause-Clear

# Deliberately late_start and deliberately shipped without a VINTF fragment.
#
# ThermalManagerService binds the AIDL HAL with waitForDeclaredService, which
# blocks. Declaring an instance that then fails to start would hang the system
# server between the boot trigger and boot-completed, which is exactly how the
# earlier ODM attempt failed. So this build proves the service runs and answers
# first, and only a later change declares it.
service thermal-hal-system /system/bin/hw/android.hardware.thermal-service.qti.system
    class late_start
    user system
    group system
